# .env.render.example
# Environment configuration template for Career Ops on Render
# Copy these values into your Render Dashboard under Environment Variables.
# DO NOT commit real secrets (.env) to version control.

# ==============================================================================
# 1. RUNTIME & PLATFORM
# ==============================================================================
NODE_VERSION=22.13.0
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
CAREER_OPS_CLOUD=1

# ==============================================================================
# 2. PERSISTENT STORAGE (CLOUDFLARE R2 FOR RENDER FREE OR PERSISTENT DISK)
# ==============================================================================
# Option A: Cloudflare R2 Storage (Recommended for Render Free tier - $0/month)
# Create a free bucket in Cloudflare R2 named 'career-ops-data' and generate an API Token.
R2_BUCKET_NAME=career-ops-data
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional custom S3 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Working directory on ephemeral container (hydrated from R2 on startup)
CAREER_OPS_ROOT=/tmp/career-ops-data

# Option B: Render Persistent Disk (Only on paid Starter plan + $1/month/GB disk)
# CAREER_OPS_ROOT=/var/data/career-ops

# Optional: override location for encrypted session storage (defaults to $CAREER_OPS_ROOT/.sessions)
# CAREER_OPS_SESSION_DIR=/var/data/career-ops/.sessions

# ==============================================================================
# 3. AUTHENTICATION, SIGN-UP & MULTI-USER WORKSPACES
# ==============================================================================
# Deployment owner username and password hash (mandatory in production)
CAREER_OPS_AUTH_USER=owner

# The scrypt password hash. Generate using: node deploy/hash-password.mjs "your-strong-password"
# Example output format: scrypt:<salt-hex>:<hash-hex>
CAREER_OPS_AUTH_PASSWORD_HASH=scrypt:YOUR_SALT_HEX:YOUR_HASH_HEX

# Optional: owner email (lets the owner sign in with Google or an email OTP code)
# CAREER_OPS_OWNER_EMAIL=owner@example.com

# 32+ byte cryptographic random secret for signing sessions and OTP digests (Render can auto-generate this)
CAREER_OPS_SESSION_SECRET=GENERATE_RANDOM_SECRET_HEX

# Sign-up policy for general users: "open" (default) or "closed"
CAREER_OPS_SIGNUP=open
# Optional comma/space-separated allowlist of emails or domains (e.g. "@company.com alice@gmail.com")
# CAREER_OPS_SIGNUP_ALLOWLIST=

# Public origin used for Google OAuth callbacks and email links (defaults to request Host)
# CAREER_OPS_PUBLIC_URL=https://career-ops.onrender.com

# ── Option 3A: Email OTP & Email Verification (Gmail SMTP or Resend) ──────────
# Gmail SMTP (create an App Password at https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=tls
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# CAREER_OPS_AUTH_EMAIL_FROM="Career Ops <yourname@gmail.com>"

# Or Resend HTTP API:
# RESEND_API_KEY=re_...
# CAREER_OPS_AUTH_EMAIL_FROM="Career Ops <auth@yourdomain.com>"

# ── Option 3B: Phone Number OTP via SMS (Twilio) ──────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Optional default country code for local numbers entered without '+' (e.g. +91, +1)
# CAREER_OPS_AUTH_DEFAULT_COUNTRY_CODE=+91
# Maximum SMS OTPs sent across the whole deployment per hour (default: 60)
# CAREER_OPS_AUTH_SMS_HOURLY_CAP=60

# ── Option 3C: Sign in / Sign up with Google (OAuth 2.0 / OIDC + PKCE) ────────
# Authorised redirect URI in Google Cloud Console: https://<your-domain>/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Per-Account Workspace Isolation ───────────────────────────────────────────
# Max concurrent Next.js tenant processes (LRU eviction on idle; default: 3)
# CAREER_OPS_MAX_WORKSPACES=3
# Minutes before an idle tenant process is stopped (default: 15)
# CAREER_OPS_WORKSPACE_IDLE_MINUTES=15
# Share deployment AI API keys with non-owner user accounts (0 = owner only, 1 = shared)
# CAREER_OPS_SHARE_AI_KEYS=0

# ==============================================================================
# 4. NETWORK & HOST PROTECTION
# ==============================================================================
# Comma-separated list of allowed hostnames (your Render URL or custom domain)
# Render automatically injects RENDER_EXTERNAL_HOSTNAME, but you can explicitly pin it here.
CAREER_OPS_WEB_ALLOWED_HOSTS=career-ops.onrender.com

# ==============================================================================
# 5. OPTIONAL AI PROVIDER API KEYS
# ==============================================================================
# If running API-based evaluations or AI integrations on Render, supply API keys here:
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# ==============================================================================
# 6. OPTIONAL PDF PAINTER DAEMON
# ==============================================================================
# Disabled by default on cloud instances to conserve RAM (recommended for < 2GB plans).
# Set to 1 only if running on a 2GB+ Standard plan with Chromium configured.
CAREER_OPS_ENABLE_PDF=0
